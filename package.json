{
  "name": "my-colyseus-game-server",
  "version": "1.0.0",
  "description": "A simple Colyseus game server",
  "main": "lib/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "dev": "nodemon --exec ts-node src/index.ts",
    "dev:watch": "concurrently \"tsc -w\" \"nodemon dist/index.js\""
  },
  "keywords": [
    "colyseus",
    "game",
    "server",
    "multiplayer"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@colyseus/monitor": "^0.16.0",
    "@colyseus/schema": "^3.0.0",
    "colyseus": "^0.16.0",
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/node": "^22.14.1",
    "concurrently": "^9.1.2",
    "nodemon": "^2.0.22",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
